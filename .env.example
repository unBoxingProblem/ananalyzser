# Maximum accepted upload size per file, in megabytes.
DATAPILOT_MAX_UPLOAD_MB=100

# Optional Gemini AI Analyst support. Keep real keys in .env or Streamlit secrets.
GEMINI_API_KEY=
# Defaults to the budget-oriented Gemini Flash-Lite model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional SQLite location for saved Dashboard Builder configurations.
# DATAPILOT_DASHBOARD_DB=/absolute/path/to/dashboards.sqlite3
